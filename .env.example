# ── DAWB Creative Studio configuration ──────────────────────────────────────
# Copy to .env.local and fill in what you need. Nothing here is required for
# LOCAL mode — the app runs with zero configuration on one computer.

# ---------- Storage (decides local vs shared workspace) ----------
# Leave empty  → LOCAL workspace: projects/uploads saved in ./data on this computer.
# Set a token  → SHARED workspace on Vercel Blob (private store). Requires Google sign-in below.
BLOB_READ_WRITE_TOKEN=
# Optional override: "fs" or "blob"
# STORAGE_DRIVER=
# Optional: where local files live (default ./data)
# DATA_DIR=

# ---------- Google sign-in (required for the shared workspace) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ character string: run  npx auth secret  or  openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL of the deployment, e.g. https://studio.dawblearn.org (Vercel sets this automatically if omitted)
# NEXTAUTH_URL=

# Who may sign in. At least one must be set or nobody can sign in.
ALLOWED_EMAIL_DOMAINS=dawblearn.org
ALLOWED_EMAILS=
# Admins can delete any project or asset (others only their own).
ADMIN_EMAILS=

# Local mode only: set to true to require Google sign-in on a local install too.
# REQUIRE_AUTH=false

# ---------- Video rendering ----------
# Server rendering (Remotion on this machine). Default: on locally, off on Vercel.
# SERVER_RENDER=true
# Parallel frames per render (default 2)
# RENDER_CONCURRENCY=2
# Optional: path to a Chrome Headless Shell; otherwise Remotion downloads one on first render.
# REMOTION_BROWSER_EXECUTABLE=
